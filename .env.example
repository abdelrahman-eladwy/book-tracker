# Copy this file to .env for local development:  cp .env.example .env
# On the server the same variables live in /etc/book_tracker/book_tracker.env

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# MongoDB connection
MONGODB_URI=mongodb://localhost:27017/
# With authentication:
# MONGODB_URI=mongodb://username:password@mongodb-server:27017/?authSource=admin
MONGODB_DATABASE=book_tracker
