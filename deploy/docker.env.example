# Environment for `docker compose`. Copy to deploy/docker.env and edit:
#   cp deploy/docker.env.example deploy/docker.env
# Do not quote values.

# --- MongoDB container (only used the FIRST time the data volume is created)
MONGO_INITDB_ROOT_USERNAME=bookadmin
MONGO_INITDB_ROOT_PASSWORD=change-me

# --- Django (host "mongo" is the MongoDB service name in docker-compose.yml)
MONGODB_URI=mongodb://bookadmin:change-me@mongo:27017/?authSource=admin
MONGODB_DATABASE=book_tracker

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
DJANGO_STATIC_ROOT=/opt/book_tracker/staticfiles
