# systemd unit for the Book Tracker Gunicorn server
#
# Install:
#   sudo cp deploy/book_tracker.service /etc/systemd/system/book_tracker.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now book_tracker

[Unit]
Description=Book Tracker (Gunicorn + Django)
After=network.target

[Service]
Type=simple
User=booktracker
Group=www-data
WorkingDirectory=/opt/book_tracker
EnvironmentFile=/etc/book_tracker/book_tracker.env
ExecStart=/opt/book_tracker/venv/bin/gunicorn -c deploy/gunicorn.conf.py book_tracker.wsgi:application
ExecReload=/bin/kill -s HUP $MAINPID
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
