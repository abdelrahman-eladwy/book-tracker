# Production environment for Book Tracker.
# Copy to /etc/book_tracker/book_tracker.env and restrict permissions:
#   sudo mkdir -p /etc/book_tracker
#   sudo cp deploy/book_tracker.env.example /etc/book_tracker/book_tracker.env
#   sudo chown root:www-data /etc/book_tracker/book_tracker.env
#   sudo chmod 640 /etc/book_tracker/book_tracker.env
#
# Note: systemd EnvironmentFile values are NOT shell-expanded; do not quote them.

DJANGO_SECRET_KEY=replace-with-output-of-python-c-secrets-token_urlsafe-50
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=example.com,www.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=http://example.com,https://example.com
DJANGO_STATIC_ROOT=/opt/book_tracker/staticfiles

MONGODB_URI=mongodb://username:password@mongodb-server:27017/?authSource=admin
MONGODB_DATABASE=book_tracker
